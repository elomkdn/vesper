<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.elomkdn.Vesper</id>
  <name>Vesper</name>
  <summary>See the sky above you, right now</summary>
  <description>
    <p>
      Vesper shows the sky over where you are: the stars in their true colours, the
      constellations, the Moon in its real phase, the planets and the Milky Way, exactly as they
      stand at this moment.
    </p>
    <ul>
      <li>Drag to look around, pinch or scroll to zoom, tap anything to learn what it is</li>
      <li>Tap the time and turn the hour and minute wheels to see the sky at any moment</li>
      <li>Tonight lists what is worth looking at, and when</li>
      <li>Find any planet, named star or constellation</li>
      <li>Use your location, or pick from 34,000 cities</li>
    </ul>
    <p>
      Everything is worked out on your device. Vesper needs no account and no connection, and it
      stays dark so it never spoils your eyes for the night.
    </p>
  </description>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
